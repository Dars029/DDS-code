#include<iostream>
using namespace std;

void TOH(int num, char src, char Aux, char dest) {
    if (num == 1) {
        cout << "Move " << src << " --> " << dest << endl;
    } else {
        TOH(num - 1, src, dest, Aux);
        TOH(1, src, Aux, dest);
        TOH(num - 1, Aux, src, dest);
    }
}

int main() {
    int n;
    cout << "Enter the number of disks: ";
    cin >> n;
    TOH(n, 'A', 'B', 'C');
    return 0;
}
